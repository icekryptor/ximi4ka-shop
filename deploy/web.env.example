# Переменные СБОРКИ витрины: NEXT_PUBLIC_* вшиваются в браузерный бандл на
# этапе build, поэтому живут здесь, а не в app.env. Реальные значения —
# deploy/web.env (НЕ коммитится); deploy.sh подхватывает его как --env-file
# для docker compose.
NEXT_PUBLIC_SITE_URL=https://new.ximi4ka.ru
NEXT_PUBLIC_API_URL=https://new.ximi4ka.ru
NEXT_PUBLIC_METRIKA_ID=101553685

# Карта ПВЗ СДЭК на чекауте — два ключа из кабинета разработчика Яндекса:
#   JavaScript API  — загрузка карты;
#   HTTP Геокодер   — поиск и адрес для курьера.
# У обоих HTTP Referrer — new.ximi4ka.ru (и ximi4ka.ru после переключения
# апекса). Виджет СДЭК умеет только один ключ, второй подставляет
# web/components/checkout/CdekWidget.tsx. Без ключа карты вместо неё —
# просьба написать менеджеру; без ключа геокодера карта берёт ключ карты.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY=

# Адрес api внутри docker-сети: по нему ходят пререндер и SSR.
API_URL=http://ximishop-api:3001
