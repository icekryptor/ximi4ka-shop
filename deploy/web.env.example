# Переменные СБОРКИ витрины: NEXT_PUBLIC_* вшиваются в браузерный бандл на
# этапе build, поэтому живут здесь, а не в app.env. Реальные значения —
# deploy/web.env (НЕ коммитится); deploy.sh подхватывает его как --env-file
# для docker compose.
NEXT_PUBLIC_SITE_URL=https://new.ximi4ka.ru
NEXT_PUBLIC_API_URL=https://new.ximi4ka.ru
NEXT_PUBLIC_METRIKA_ID=101553685

# Карта ПВЗ СДЭК на чекауте. Кабинет разработчика Яндекса → «JavaScript API и
# HTTP Геокодер», HTTP Referrer — new.ximi4ka.ru (и ximi4ka.ru после
# переключения апекса). Без ключа вместо карты — просьба написать менеджеру.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Адрес api внутри docker-сети: по нему ходят пререндер и SSR.
API_URL=http://ximishop-api:3001
