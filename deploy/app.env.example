# Серверные env api-контейнера витрины. Реальные значения — в deploy/app.env
# (НЕ коммитится). База — отдельная БД ximi4ka_shop в контейнере supabase-db.
NODE_ENV=production
PORT=3001

# Postgres по docker-сети (alias `db` у supabase-db). Хост без точки → TLS
# выключается сам (см. api/src/config/dataSource.ts); DATABASE_SSL не нужен.
DATABASE_URL=postgres://ximishop_user:СМ-/opt/ximishop/.db-pass@db:5432/ximi4ka_shop

# Сессии админки: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# CORS: откуда браузер зовёт api.
WEB_ORIGIN=https://new.ximi4ka.ru

# Лимиты частоты с одного IP (необязательно; по умолчанию как ниже, потолок 1000,
# значения вне 1…1000 игнорируются). Поднимать стоит, если за одним адресом
# сидит много покупателей, например за мобильным CGNAT во время акции.
# CHECKOUT_RATE_LIMIT=20   # заказов в час
# LOGIN_RATE_LIMIT=10      # попыток входа в админку за 15 минут
# PASSWORD_RATE_LIMIT=5    # попыток смены пароля админа за 15 минут
# EVENTS_RATE_LIMIT=300    # событий-целей витрины (add_to_cart, …) за 10 минут
# WEB_VITALS_RATE_LIMIT=150  # полевых Web Vitals (web_vital) за 10 минут, отдельно от целей
# Доставка СДЭК (docs/plans/2026-09-23-cdek-delivery-design.md). Ключи — ЛК
# СДЭК → «Интеграция» → «Создать ключ». Без ключей api работает с тестовой
# средой СДЭК (общая учётка из документации) — на проде так нельзя.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Боевая среда по умолчанию, если заданы ключи. Тестовая: https://api.edu.cdek.ru/v2
# CDEK_API_URL=https://api.cdek.ru/v2
# Город отправки (код СДЭК; 44 — Москва) и тарифы: 136 «Посылка склад-склад»
# до ПВЗ, 137 «Посылка склад-дверь» курьером.
CDEK_FROM_CITY_CODE=44
CDEK_TARIFF_PVZ=136
CDEK_TARIFF_COURIER=137
# Заказ в СДЭК после оплаты (docs/superpowers/specs/2026-09-25-cdek-auto-orders-design.md).
# Выключено, пока не равно true. Вне NODE_ENV=production заказы создаются только
# в песочнице (CDEK_API_URL=https://api.edu.cdek.ru/v2).
CDEK_ORDERS_ENABLED=
# Пункт СДЭК, куда магазин сдаёт посылки. Боевой — MSK310 (пр-т Мира, 108);
# в песочнице его нет — там MOS4.
CDEK_SHIPMENT_POINT=MSK310
# Отправитель — как в ЛК СДЭК (значения не коммитить).
CDEK_SENDER_COMPANY=
CDEK_SENDER_NAME=
CDEK_SENDER_PHONE=
CDEK_SENDER_EMAIL=
# Продавец в заказе; по умолчанию = CDEK_SENDER_COMPANY.
# CDEK_SELLER_NAME=


# Уведомления о заказах (docs/superpowers/specs/2026-09-25-order-notifications-design.md).
# Пустые значения — канал выключен, записи копятся в очереди и уйдут, когда
# ключи появятся. Настройка по шагам — deploy/README.md, «Уведомления о заказах».
# Бот магазина: токен от @BotFather и id рабочего чата (у групп отрицательный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Сервисный аккаунт Google: JSON-ключ целиком — одной строкой или в base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
# id таблицы — часть адреса между /d/ и /edit. Лист — «Заказы».
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Заказы

# Офлайн-конверсии: оплата заказа с рекламным переходом (yclid) уходит в
# Яндекс.Метрику, чтобы Директ учился на оплатах, а не на кликах. Выключено,
# пока METRIKA_OFFLINE_ENABLED не true. По шагам — deploy/README.md,
# «Конверсии оплаты в Яндекс.Метрику».
METRIKA_OFFLINE_ENABLED=
# OAuth-токен с правом загрузки данных в Метрику (не коммитить).
METRIKA_OAUTH_TOKEN=
# Идентификатор цели в Метрике (цель «JavaScript-событие»), по умолчанию order_paid.
# METRIKA_OFFLINE_TARGET=order_paid
# Номер счётчика берётся из настроек сайта в админке; здесь нужен, только если
# там пусто.
# METRIKA_COUNTER_ID=

# Раздел админки «Трафик и рост»: раз в сутки статистика Метрики (и позже
# Вебмастера) копируется в базу. Выключено, пока SEARCH_STATS_SYNC_ENABLED
# не true. Токен — отдельный, только на чтение (metrika:read,
# webmaster:hostinfo, webmaster:verify); не коммитить. По шагам —
# deploy/README.md, «Статистика трафика в админке».
SEARCH_STATS_SYNC_ENABLED=
YANDEX_STATS_OAUTH_TOKEN=

# Заявки со страницы /get_materials (QR-коды на наборах) дописываются в таблицу
# «Покупатели набора» тем же сервисным аккаунтом: дайте его почте доступ
# «Редактор» и к ней. Пустой MATERIALS_SHEETS_ID — в таблицу не пишем.
MATERIALS_SHEETS_ID=
MATERIALS_SHEETS_TAB=Лист1
# Первая строка, с которой дописываем (выше ничего не трогаем).
MATERIALS_SHEETS_START_ROW=6256

# Оплата: manual — заказ без онлайн-оплаты, менеджер связывается сам.
# tbank — Т-Касса; тогда нужны TERMINAL_KEY/PASSWORD из личного кабинета.
PAYMENT_PROVIDER=manual
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_NOTIFICATION_URL=https://new.ximi4ka.ru/api/webhooks/tbank
# После оплаты банк возвращает покупателя на страницу его заказа с секретом
# (адрес строится из WEB_ORIGIN). SUCCESS/FAIL_URL — запасной путь, если
# WEB_ORIGIN пуст: /success и /fail переадресуют на заказ по OrderId.
TBANK_SUCCESS_URL=https://new.ximi4ka.ru/success
TBANK_FAIL_URL=https://new.ximi4ka.ru/fail
# Чек по 54-ФЗ: терминал с онлайн-кассой отклоняет Init без Receipt
# (ErrorCode=309, Details request.validate.expected.receipt). Значения по
# умолчанию ниже; менять нужно, только если изменился статус продавца.
# Отключить отправку чека (терминал без кассы): TBANK_SEND_RECEIPT=false.
# TBANK_TAXATION: osn | usn_income | usn_income_outcome | esn | patent
# TBANK_RECEIPT_TAX: none | vat0 | vat5 | vat7 | vat10 | vat22
TBANK_SEND_RECEIPT=true
TBANK_TAXATION=usn_income
TBANK_RECEIPT_TAX=none

# Яндекс Пэй и Сплит (console.pay.yandex.ru → «Настройки»). Пусто — способа нет,
# у покупателей ничего не меняется. В песочнице ключом API служит сам Merchant ID,
# но на проде песочница недоступна. Режим и рубильник — в админке («Настройки» →
# «Яндекс.Pay»). Callback URL в кабинете: https://ximi4ka.ru/api/webhooks/yandex-pay.
# Ставка налога позиций — TBANK_RECEIPT_TAX выше. Порядок — deploy/README.md.
YANDEX_PAY_MERCHANT_ID=
YANDEX_PAY_API_KEY=

# CloudPayments — оплата картами Visa / Mastercard банков стран ЕАЭС (только доставка
# в BY/KZ/AM/KG). Public ID и API Secret — из кабинета merchant.cloudpayments.ru,
# раздел сайта. API Secret — пароль API и ключ подписи уведомлений, никому не передавать.
# Рубильник, режим и надбавка — в админке (Настройки → CloudPayments).
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# ERP-inbound (фаза 5) — пока не включено.
ERP_INBOUND_URL=
ERP_SHARED_SECRET=

# Наблюдаемость (опционально).
SENTRY_DSN=

# Почта: коды входа в личный кабинет. Без SMTP_HOST в проде вход по email выключен,
# вне прода письма печатаются в лог api.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@ximi4ka.ru
SMTP_PASS=
MAIL_FROM="Химичка <noreply@ximi4ka.ru>"

# Покупательский бот для входа в кабинет (не служебный @ximsite_bot).
# Секрет — любая случайная строка A-Za-z0-9_- (openssl rand -hex 32).
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_LOGIN_WEBHOOK_SECRET=
# 1 — api сам забирает update (getUpdates), вебхук не нужен и снимается при
# старте. Для сервера, до которого Telegram не достучится (у нас IPv4 до
# Telegram закрыт в обе стороны — «Connection timed out» в getWebhookInfo).
TELEGRAM_LOGIN_POLLING=

# ximi4ka ID — вход в XimiLearn аккаунтом магазина
# (docs/superpowers/specs/2026-09-29-ximi4ka-id-sso-design.md). Тот же секрет —
# в XIMI4KA_SSO_CLIENT_SECRET у learn. Секрет короче 32 символов или пустой
# список адресов — клиент выключен. Генерация: openssl rand -hex 32.
# Адреса возврата — через запятую, точное совпадение.
SSO_LEARN_CLIENT_SECRET=
SSO_LEARN_REDIRECT_URIS=https://learn.ximi4ka.ru/api/auth/ximi4ka/callback

# Yandex Commerce Protocol — «Купить в 1 клик» в Алисе и Поиске
# (docs/superpowers/specs/2026-10-11-ycp-integration-design.md, docs/ycp/RUNBOOK.md).
# Токен придумывает владелец (openssl rand -hex 32) и вносит сюда и в поле
# «Токен доступа» кабинета YCP. Пусто или короче 32 символов — /api/v1 отвечает
# 401 на всё и фоновая загрузка пунктов выдачи СДЭК не запускается.
# WEB_ORIGIN (выше) в проде обязателен: из него строятся ссылки на товары и
# картинки в ответах Яндексу, без него там окажется http://localhost:3000.
YCP_API_TOKEN=
# Склад для GET /api/v1/warehouses и остатков в basket/check. Любое поле пустое —
# методы, которым нужен склад, отвечают 500.
YCP_WAREHOUSE_ID=msk-1
YCP_WAREHOUSE_TITLE=Склад Химички
YCP_WAREHOUSE_ADDRESS=
YCP_WAREHOUSE_PHONE=
# Общий срок на вызовы СДЭК в /api/v1/checkout/delivery/options, мс (1–4000).
# YCP_CDEK_TIMEOUT_MS=3500

# --- Закрытые материалы («Мои материалы») ---
# Каталог файлов материалов внутри контейнера api; том ximishop-materials.
# По умолчанию (если не задан) — api/materials рядом с кодом.
MATERIALS_DIR=/app/api/materials
