# Серверные env api-контейнера витрины. Реальные значения — в deploy/app.env
# (НЕ коммитится). База — отдельная БД ximi4ka_shop в контейнере supabase-db.
NODE_ENV=production
PORT=3001

# Postgres по docker-сети (alias `db` у supabase-db). Хост без точки → TLS
# выключается сам (см. api/src/config/dataSource.ts); DATABASE_SSL не нужен.
DATABASE_URL=postgres://ximishop_user:СМ-/opt/ximishop/.db-pass@db:5432/ximi4ka_shop

# Сессии админки: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# CORS: откуда браузер зовёт api.
WEB_ORIGIN=https://new.ximi4ka.ru
# Доставка СДЭК (docs/plans/2026-09-23-cdek-delivery-design.md). Ключи — ЛК
# СДЭК → «Интеграция» → «Создать ключ». Без ключей api работает с тестовой
# средой СДЭК (общая учётка из документации) — на проде так нельзя.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Боевая среда по умолчанию, если заданы ключи. Тестовая: https://api.edu.cdek.ru/v2
# CDEK_API_URL=https://api.cdek.ru/v2
# Город отправки (код СДЭК; 44 — Москва) и тарифы: 136 «Посылка склад-склад»
# до ПВЗ, 137 «Посылка склад-дверь» курьером.
CDEK_FROM_CITY_CODE=44
CDEK_TARIFF_PVZ=136
CDEK_TARIFF_COURIER=137
# Заказ в СДЭК после оплаты (docs/superpowers/specs/2026-09-25-cdek-auto-orders-design.md).
# Выключено, пока не равно true. Вне NODE_ENV=production заказы создаются только
# в песочнице (CDEK_API_URL=https://api.edu.cdek.ru/v2).
CDEK_ORDERS_ENABLED=
# Пункт СДЭК, куда магазин сдаёт посылки. Боевой — MSK310 (пр-т Мира, 108);
# в песочнице его нет — там MOS4.
CDEK_SHIPMENT_POINT=MSK310
# Отправитель — как в ЛК СДЭК (значения не коммитить).
CDEK_SENDER_COMPANY=
CDEK_SENDER_NAME=
CDEK_SENDER_PHONE=
CDEK_SENDER_EMAIL=
# Продавец в заказе; по умолчанию = CDEK_SENDER_COMPANY.
# CDEK_SELLER_NAME=


# Уведомления о заказах (docs/superpowers/specs/2026-09-25-order-notifications-design.md).
# Пустые значения — канал выключен, записи копятся в очереди и уйдут, когда
# ключи появятся. Настройка по шагам — deploy/README.md, «Уведомления о заказах».
# Бот магазина: токен от @BotFather и id рабочего чата (у групп отрицательный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Сервисный аккаунт Google: JSON-ключ целиком — одной строкой или в base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
# id таблицы — часть адреса между /d/ и /edit. Лист — «Заказы».
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Заказы

# Оплата: manual — заказ без онлайн-оплаты, менеджер связывается сам.
# tbank — Т-Касса; тогда нужны TERMINAL_KEY/PASSWORD из личного кабинета.
PAYMENT_PROVIDER=manual
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_NOTIFICATION_URL=https://new.ximi4ka.ru/api/webhooks/tbank
TBANK_SUCCESS_URL=https://new.ximi4ka.ru/success
TBANK_FAIL_URL=https://new.ximi4ka.ru/fail

# ERP-inbound (фаза 5) — пока не включено.
ERP_INBOUND_URL=
ERP_SHARED_SECRET=

# Наблюдаемость (опционально).
SENTRY_DSN=
